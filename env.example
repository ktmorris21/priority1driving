# App
PORT=3000
NODE_ENV=development

# Use "console" while developing. Set to "smtp" in Railway when ready.
EMAIL_MODE=console

# Fallback recipients used until routing rules are finalized.
# Comma-separated addresses.
DEFAULT_RECIPIENTS=

# SMTP (required only when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
